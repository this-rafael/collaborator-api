NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27018/collaborator_documents?replicaSet=rs0
CURSOR_HMAC_SECRET=change-this-development-secret-to-at-least-32-bytes
LOG_LEVEL=debug
CORS_ALLOWLIST=http://localhost:3000,http://localhost:5173
RATE_LIMIT_GET=60
RATE_LIMIT_WRITE=20
RATE_LIMIT_WINDOW_MS=60000
OPENAPI_PATH=/openapi.json
OTEL_ENABLED=false
OTEL_SERVICE_NAME=collaborator-document-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14318
SONAR_TOKEN=
