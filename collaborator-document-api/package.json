{
  "name": "collaborator-document-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de gerenciamento de documentação de colaboradores",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.9.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs",
    "dev": "node --env-file-if-exists=.env --watch --import @swc-node/register/esm-register src/index.ts",
    "build": "pnpm typecheck && swc src -d dist --strip-leading-paths --delete-dir-on-start",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:http": "vitest run --project http",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "test:coverage": "vitest run --coverage",
    "test:self-check": "node scripts/verify-test-runner.mjs",
    "test:smoke": "node scripts/smoke-built-app.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "verify": "pnpm check:runtime && pnpm format:check && pnpm lint && pnpm build && pnpm test:self-check && pnpm test:coverage && pnpm test:smoke",
    "test:watch": "vitest",
    "hooks:install": "lefthook install",
    "hooks:pre-commit": "lefthook run pre-commit --all-files",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@tsed/ajv": "8.37.1",
    "@tsed/core": "8.37.1",
    "@tsed/di": "8.37.1",
    "@tsed/exceptions": "8.37.1",
    "@tsed/json-mapper": "8.37.1",
    "@tsed/logger": "8.0.5",
    "@tsed/mongoose": "8.37.1",
    "@tsed/openspec": "8.37.1",
    "@tsed/platform-express": "8.37.1",
    "@tsed/platform-http": "8.37.1",
    "@tsed/platform-views": "8.37.1",
    "@tsed/schema": "8.37.1",
    "ajv": "^8.17.1",
    "body-parser": "^1.20.3",
    "express": "^5.2.1",
    "mongodb": "^7.5.0",
    "mongoose": "9.8.0",
    "multer": "^2.0.2",
    "neverthrow": "^8.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.46",
    "@testcontainers/mongodb": "^12.0.4",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.1.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "lefthook": "^1.12.2",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "testcontainers": "^12.0.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.2.4"
  }
}
